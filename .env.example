# Public Supabase project values. Copy this file to .env.local for local use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical public URL. Use http://localhost:3000 locally and the final
# https://... Vercel domain in Production and Preview environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
