# Public Supabase project values. Copy this file to .env.local for local use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical public URL. Use http://localhost:3000 locally and the final
# https://... Vercel domain in Production and Preview environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Gmail app password for docroutestu@gmail.com (welcome email).
SMTP_PASS=

# Plus through Whop (server-only, never NEXT_PUBLIC_). See docs/PAYMENTS.md.
# "sandbox" (default, test cards, no real money) or "production".
WHOP_ENVIRONMENT=sandbox
# Account API key from Whop → Developer.
WHOP_API_KEY=
# The Plus plan/variant id, plan_…
WHOP_PLUS_VARIANT_ID=
# Webhook signing secret, ws_… (paste exactly as Whop shows it).
WHOP_WEBHOOK_SECRET=
# "true" shows the Buy button on /plus and the Plus terms.
PAYMENTS_ENABLED=false
# Supabase secret key (sb_secret_…) for the webhook only.
SUPABASE_SECRET_KEY=
